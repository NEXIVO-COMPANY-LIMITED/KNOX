<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_lock"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="48dp"
    android:paddingBottom="40dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/actionSection"
        app:layout_constraintVertical_bias="0.35">

        <!-- Lock Badge -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_lock_badge"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock_outline"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_title"
            android:textColor="#FF0000"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="12dp" />

        <!-- Subtitle / Reason -->
        <TextView
            android:id="@+id/tvLockReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_reason_waiting"
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.5"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvLoanNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textAlignment="center"
            android:layout_marginBottom="20dp"
            tools:text="LN-2026-00001" />

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_lock_phone_input"
            android:hint="@string/lock_phone_hint"
            android:inputType="phone"
            android:importantForAutofill="no"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Lipia Sasa / Pay Now (public installment init) -->
        <LinearLayout
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_pay_now"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_phone_outline"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvPayNowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_pay_now"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPaymentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textAlignment="center"
            android:visibility="gone"
            tools:text="Confirm the USSD prompt on your phone…"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Action Section -->
    <LinearLayout
        android:id="@+id/actionSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Emergency OTP Button -->
        <Button
            android:id="@+id/btnKioskOfflineUnlock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/lock_emergency_otp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="4dp"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@null" />

        <!-- Call Support Button -->
        <LinearLayout
            android:id="@+id/btnCallSupport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_secondary"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_phone_outline"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_call_support"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_footer_brand"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_footer_subtitle"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:alpha="0.6" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
