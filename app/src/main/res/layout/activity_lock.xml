<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0F172A"
    android:gravity="center">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@android:drawable/ic_lock_lock"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEVICE LOCKED"
        android:textColor="#EF4444"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvLockReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Installment Payment Due. Please pay to continue using your phone."
        android:textColor="#E2E8F0"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="20dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/tvLoanNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loan ID: LN-2026-08912"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Payment Method: Pay via M-Pesa / Tigo Pesa / Airtel Money"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Support Contact: +255 712 345 678"
            android:textColor="#94A3B8"
            android:textSize="14sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnKioskOfflineUnlock"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Emergency Offline Unlock"
        android:backgroundTint="#0284C7"
        android:textColor="#FFFFFF"
        android:textSize="16sp"/>

</LinearLayout>
