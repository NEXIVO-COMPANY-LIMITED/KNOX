<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_lock"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="40dp">

    <!-- Back Button -->
    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_keypad_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_arrow_back" />
    </FrameLayout>

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emergency Unlock"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter the 6-digit passcode sent to your registered phone number via SMS."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:textAlignment="center" />
    </LinearLayout>

    <!-- OTP Input Boxes -->
    <LinearLayout
        android:id="@+id/otpContainer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <TextView
            android:id="@+id/otpDigit1"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_otp_box_empty"
            android:gravity="center"
            android:text="4"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/otpDigit2"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_otp_box_empty"
            android:gravity="center"
            android:text="7"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Active Box Example -->
        <TextView
            android:id="@+id/otpDigit3"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_otp_box_active"
            android:gravity="center"
            android:text="|"
            android:textColor="#0284C7"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Empty Box Example -->
        <TextView
            android:id="@+id/otpDigit4"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_otp_box_empty"
            android:gravity="center"
            android:text="•"
            android:textColor="#475569"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/otpDigit5"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_otp_box_empty"
            android:gravity="center"
            android:text="•"
            android:textColor="#475569"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/otpDigit6"
            android:layout_width="48dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_otp_box_empty"
            android:gravity="center"
            android:text="•"
            android:textColor="#475569"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Verify Button -->
    <Button
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_btn_primary"
        android:text="Verify &amp; Unlock"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/otpContainer"
        app:backgroundTint="@null" />

    <!-- Custom Numeric Keypad -->
    <GridLayout
        android:id="@+id/keypadContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnVerify"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1 -->
        <TextView android:text="1" style="@style/KeypadButton" />
        <TextView android:text="2" style="@style/KeypadButton" />
        <TextView android:text="3" style="@style/KeypadButton" />

        <!-- Row 2 -->
        <TextView android:text="4" style="@style/KeypadButton" />
        <TextView android:text="5" style="@style/KeypadButton" />
        <TextView android:text="6" style="@style/KeypadButton" />

        <!-- Row 3 -->
        <TextView android:text="7" style="@style/KeypadButton" />
        <TextView android:text="8" style="@style/KeypadButton" />
        <TextView android:text="9" style="@style/KeypadButton" />

        <!-- Row 4 -->
        <Space android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="12dp" />
        <TextView android:text="0" style="@style/KeypadButton" />

        <FrameLayout style="@style/KeypadButton">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_backspace" />
        </FrameLayout>

    </GridLayout>

    <!-- Footer Section -->
    <LinearLayout
        android:id="@+id/footerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/keypadContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <TextView
            android:id="@+id/tvDidntReceiveCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Didn't receive a code?"
            android:textColor="#0284C7"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAYO SECURE"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This device is protected by official kiosk MDM."
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:alpha="0.6" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
